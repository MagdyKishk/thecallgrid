//- SEO Meta Tags Partial
//- Comprehensive meta tags for SEO, Open Graph, Twitter Cards, and JSON-LD

//- Basic Meta
title= title || 'TheCallGrid - Professional Lead Generation Services'
meta(name="description" content=description || 'Professional lead generation and call services with C1+ callers.')
if keywords
  meta(name="keywords" content=keywords)

//- Canonical URL
- const canonicalUrl = `${siteUrl}${canonical || ''}`
link(rel="canonical" href=canonicalUrl)

//- Open Graph Tags (Facebook, LinkedIn)
meta(property="og:site_name" content=siteName)
meta(property="og:title" content=title)
meta(property="og:description" content=description)
meta(property="og:url" content=canonicalUrl)
meta(property="og:type" content=ogType || 'website')
meta(property="og:image" content=ogImage || `${siteUrl}/assets/images/og-image.jpg`)
meta(property="og:image:width" content="1200")
meta(property="og:image:height" content="630")
meta(property="og:locale" content="en_US")

//- Twitter Card Tags
meta(name="twitter:card" content="summary_large_image")
meta(name="twitter:title" content=title)
meta(name="twitter:description" content=description)
meta(name="twitter:image" content=ogImage || `${siteUrl}/assets/images/og-image.jpg`)
if twitterHandle
  meta(name="twitter:site" content=twitterHandle)

//- Additional SEO
meta(name="robots" content="index, follow")
meta(name="author" content="TheCallGrid")
meta(name="theme-color" content="#1a73e8")

//- Mobile App Tags
meta(name="mobile-web-app-capable" content="yes")
meta(name="apple-mobile-web-app-capable" content="yes")
meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")

//- Hreflang (scaffold for future multi-locale support)
//- link(rel="alternate" hreflang="en-US" href=canonicalUrl)

//- JSON-LD Structured Data
if pageClass === 'page-home' || pageClass === 'page-contact'
  script(type="application/ld+json").
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "#{siteName}",
      "description": "Professional lead generation and call services with C1+ professional callers averaging 4+ years of experience.",
      "url": "#{siteUrl}",
      "telephone": "#{companyPhone}",
      "email": "#{companyEmail}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "123 Main Street",
        "addressLocality": "Cheyenne",
        "addressRegion": "WY",
        "postalCode": "82001",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "41.1400",
        "longitude": "-104.8202"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "priceRange": "$$",
      "image": "#{siteUrl}/assets/logo.svg",
      "logo": "#{siteUrl}/assets/logo.svg",
      "sameAs": [
        "https://www.facebook.com/thecallgrid",
        "https://www.linkedin.com/company/thecallgrid",
        "https://twitter.com/thecallgrid"
      ]
    }

if pageClass === 'page-contact'
  script(type="application/ld+json").
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "url": "#{siteUrl}/contact",
      "mainEntity": {
        "@type": "Organization",
        "name": "#{siteName}",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "#{companyPhone}",
          "email": "#{companyEmail}",
          "contactType": "Customer Service",
          "areaServed": "US",
          "availableLanguage": ["English"]
        }
      }
    }

