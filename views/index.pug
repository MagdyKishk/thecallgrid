  //- CTA Banner Section
  section.cta-banner.section(data-observe)
    .container
      .cta-banner-grid
        //- Newsletter & SMS Signup
        .cta-banner-item.signup-section
          .cta-icon
            i.fas.fa-envelope
          h3.cta-banner-title Stay Connected
          p.cta-banner-description Get exclusive insights, tips, and updates delivered to your inbox or phone.
          .signup-form
            form.inline-form
              .form-row
                input.form-input(type="email" placeholder="Enter your email" required)
                button.btn.btn-primary(type="submit") 
                  span Subscribe
                  i.fas.fa-arrow-right
              .form-row
                input.form-input(type="tel" placeholder="Enter your phone (SMS)" required)
                button.btn.btn-secondary(type="submit")
                  span Join SMS
                  i.fas.fa-arrow-right
        
        //- Book a Call CTA
        .cta-banner-item.call-section
          .cta-icon
            i.fas.fa-calendar-check
          h3.cta-banner-title Ready to Scale Your Business?
          p.cta-banner-description Connect with our team and discover how C1+ callers can transform your pipeline in 24-48 hours.
          .cta-stats
            .stat-item
              .stat-value(data-target="98" data-suffix="%") 0
              .stat-label Satisfaction
            .stat-item
              .stat-value(data-target="30" data-suffix="K+") 0
              .stat-label Leads Generated
            .stat-item
              .stat-value(data-target="100" data-prefix="$" data-suffix="M+") 0
              .stat-label Total Closings
          a.btn.btn-primary.btn-xl(href="/contact")
            i.fas.fa-phone-alt
            span Book A Call Now
            i.fas.fa-arrow-right

