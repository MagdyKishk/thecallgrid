extends layout

block content
  //- Hero Section
  section.hero#hero(data-observe)
    .hero-content.container
      .hero-badge
        span.badge-icon ⭐
        span.badge-text Trusted by Industry Leaders
      
      .hero-main
        h1.hero-title
          span.title-line Transform Your
          span.title-line.highlight Lead Generation
          span.title-subtitle with C1+ Professional Callers
        
        p.hero-description 
          | Elite call services powered by 
          strong experienced professionals averaging 4+ years
          | . 
          br
          | Specialized expertise in Real Estate, Solar, Roofing, and Home Renovation industries.
        
        .hero-features
          .hero-feature
            span.feature-check
              i.fas.fa-check
            span.feature-text C1+ Language Proficiency
          .hero-feature
            span.feature-check
              i.fas.fa-check
            span.feature-text 4+ Years Average Experience
          .hero-feature
            span.feature-check
              i.fas.fa-check
            span.feature-text Industry-Specialized Teams
          .hero-feature
            span.feature-check
              i.fas.fa-check
            span.feature-text 98% Client Satisfaction
          .hero-feature
            span.feature-check
              i.fas.fa-check
            span.feature-text Start Calling In 24-48 Hours
        
        .hero-cta
          a.btn.btn-primary.btn-xl(href="/contact")
            i.fas.fa-envelope
            span Contact Us
            i.fas.fa-arrow-right
          
  

  //- Industries Served Section
  section.industries.section.bg-light(data-observe)
    .container
      .section-header
        .section-subtitle.theme-color Specialized Expertise
        h2.section-title.theme-color Industries We Serve
      
      //- Real Estate Industry - Image Left, Text Right
      .industry-showcase.industry-left(data-observe)
        .industry-image
          img(
            src="/assets/images/industry-realestate.jpg" 
            alt="Real Estate Wholesaling Team"
          )
          .industry-decorations
            .decoration-bar
            .decoration-dots
        .industry-content
          .industry-subtitle Professional Real Estate Expertise
          h3.industry-title Real Estate Wholesaling
          p.industry-description
            | Our specialized team understands property valuations, motivated seller psychology, 
            | and deal flow optimization. We connect you with pre-qualified leads for wholesalers, 
            | investors, and fix-and-flip professionals who are ready to make deals.
          .industry-features
            .feature-item
              i.fas.fa-chart-line
              span Motivated Seller Identification
            .feature-item
              i.fas.fa-home
              span Property Pre-qualification
            .feature-item
              i.fas.fa-handshake
              span Deal Flow Management
          a.industry-cta.btn.btn-primary(href="/services#real-estate") Get Started
      
      //- Solar Energy Industry - Text Left, Image Right
      .industry-showcase.industry-right(data-observe)
        .industry-content
          .industry-subtitle Sustainable Energy Solutions
          h3.industry-title Solar Energy
          p.industry-description
            | Expert solar lead generation with callers trained in energy savings, ROI calculations, 
            | and environmental benefits. We identify homeowners interested in solar installation 
            | and convert them into qualified leads through ROI-focused conversations.
          .industry-features
            .feature-item
              i.fas.fa-solar-panel
              span Homeowner Qualification
            .feature-item
              i.fas.fa-calculator
              span ROI Presentation
            .feature-item
              i.fas.fa-calendar-check
              span Installation Scheduling
          a.industry-cta.btn.btn-primary(href="/services#solar") Get Started
        .industry-image
          img(
            src="/assets/images/industry-solar.jpg" 
            alt="Solar Energy Consultation"
          )
          .industry-decorations
            .decoration-bar
            .decoration-dots
      
      //- Roofing Industry - Image Left, Text Right
      .industry-showcase.industry-left(data-observe)
        .industry-image
          img(
            src="/assets/images/industry-roofing.jpg" 
            alt="Roofing Services Team"
          )
          .industry-decorations
            .decoration-bar
            .decoration-dots
        .industry-content
          .industry-subtitle Storm Damage & Home Improvement
          h3.industry-title Roofing & Home Renovation
          p.industry-description
            | Professional roofing lead generation focused on storm damage, insurance claims, 
            | and home improvement projects. Our callers identify urgent needs and qualified 
            | prospects ready to invest in their homes.
          .industry-features
            .feature-item
              i.fas.fa-cloud-rain
              span Storm Damage Assessment
            .feature-item
              i.fas.fa-shield-alt
              span Insurance Claim Assistance
            .feature-item
              i.fas.fa-tools
              span Emergency Response
          a.industry-cta.btn.btn-primary(href="/services#roofing") Get Started
