//- Main Layout Template
//- Server-rendered base template with SEO meta tags, analytics, and structure
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="ie=edge")
    
    //- SEO Meta Tags (server-rendered for crawlers)
    include partials/_meta
    
    //- Preconnect for performance
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    
    //- FontAwesome (Local)
    link(rel="stylesheet" href="/fonts/fontawesome/css/all.min.css")
    
    //- Favicon
    link(rel="icon" type="image/x-icon" href="/assets/favicon.ico")
    link(rel="apple-touch-icon" href="/assets/apple-touch-icon.png")
    
    //- Fonts
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    
    //- Stylesheets
    link(rel="stylesheet" href="/libs/swiper.css")
    link(rel="stylesheet" href="/css/main.css")
    
    //- Google Analytics (if configured)
    if gaMeasurementId
      script(async src=`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`)
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '#{gaMeasurementId}');
    
    block head
  
  body(class=pageClass)
    //- Skip to main content (accessibility)
    a.skip-to-main(href="#main-content") Skip to main content
    
    //- P5.js Canvas Container (fullscreen background for entire site)
    #p5-canvas-container(aria-hidden="true")
    
    //- Header
    include partials/header
    
    //- Main Content
    main#main-content(role="main")
      block content
    
    //- Footer
    include partials/footer
    
    
    //- Core JavaScript
    script(src="/libs/swiper.min.js")
    script(src="/js/main.js" defer)
    script(src="/js/testimonials-slider.js" defer)
    script(src="/js/intersection-observer.js" defer)
    
    //- P5.js Grid
    script(src="https://cdn.jsdelivr.net/npm/p5@1.7.0/lib/p5.min.js" async)
    script(src="/js/p5grid.js" defer)
    
    //- Page-specific scripts
    block scripts

