//- Main Layout Template
//- Server-rendered base template with SEO meta tags, analytics, and structure
doctype html
html(lang="en-US" itemscope itemtype="https://schema.org/WebSite")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(http-equiv="Content-Type" content="text/html; charset=UTF-8")
    meta(http-equiv="Content-Language" content="en-US")
    
    //- SEO Meta Tags (server-rendered for crawlers)
    include partials/_meta
    
    //- Preconnect for performance
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    
    //- FontAwesome (Local)
    link(rel="stylesheet" href="/fonts/fontawesome/css/all.min.css")
    
    //- Favicon
    link(rel="icon" type="image/svg+xml" href="/assets/favicon.svg")
    link(rel="apple-touch-icon" href="/assets/favicon.svg")
    link(rel="manifest" href="/manifest.json")
    
    //- Fonts
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    
    //- Stylesheets
    link(rel="stylesheet" href="/libs/swiper.css")
    link(rel="stylesheet" href="/css/main.css")
    
    //- Google Analytics (if configured)
    if gaMeasurementId
      script(async src=`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`)
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '#{gaMeasurementId}');
    
    block head
  
  body(class=pageClass)
    //- Grid Background
    #grid-background(aria-hidden="true")
    
    //- Skip to main content (accessibility)
    a.skip-to-main(href="#main-content") Skip to main content
    
    //- Header
    include partials/header
    
    //- Main Content
    main#main-content(role="main")
      block content
    
    //- Footer
    include partials/footer
    
    
    //- Core JavaScript
    script(src="/libs/swiper.min.js")
    script(src="/js/main.js" defer)
    script(src="/js/testimonials-slider.js" defer)
    script(src="/js/intersection-observer.js" defer)
    
    //- Page-specific scripts
    block scripts

